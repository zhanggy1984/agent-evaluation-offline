# ---- 密钥与环境变量 ----
# 真实环境变量（含 DB/JWT/FERNET/LLM/SMTP 密钥），严禁提交
.env

# ---- 构建产物与依赖 ----
node_modules/
dist/
frontend/dist/

# ---- 运行时数据与导出（报告/测试附件，体积大）----
uploads/
backend/uploads/
backend/exports/
backend/backups/
backend/*.pdf
backups/

# ---- Python 缓存 ----
__pycache__/
*.pyc
.pytest_cache/

# ---- 本地工具痕迹 ----
.claude/
.codegraph/

# ---- 内部验收产物：逐 issue 一次性脚本（含测试凭据），不进仓库 ----
backend/verify_*.py
# 例外：verify_fresh_start.py 是空库重建冒烟矩阵（官方验证脚本，凭据走 env 不入库），纳入版本控制
!backend/verify_fresh_start.py
backend/run_*.py
backend/trigger_*.py
backend/expand_*.py
backend/fix_*.py
backend/gen_*.py
backend/gold_*.py
backend/heldout_*.py
backend/monitor_run.py
verify_probe*.py
acceptance-*.md
agent-baseline.md

# ---- 一次性调试/探针/迁移脚本（硬编码测试凭据 123456 / 明文 DB 密码 / access_token），不进仓库 ----
# 与 verify_*.py 同纪律；已追踪的 scripts/_gate_majority.py（正式门禁脚本）不受 gitignore 影响
scripts/_*.py
scripts/_*.sh
scripts/_*.log
scripts/reset_passwords_*.py
# 例外：无凭据的 seed 修正工具纳入版本控制
!scripts/_sync_refdocs.py
!scripts/_fix_seed_chat.py

# ---- 本地调试临时目录（cc 测试 PDF 上传产物，体积大）----
.tmp_cc_uploads/
