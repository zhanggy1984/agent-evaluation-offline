# ============ AI Agent 评测系统 环境变量模板 ============
# 复制为 .env 后填写；脚本 scripts/init-env.ps1 会自动生成随机密钥并写入。
# env 只放密钥类；业务参数（权重/阈值/并发/超时/单价）一律落 system_config 表。

# ---- 运行环境 ----
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- MySQL（docker-compose 内网地址）----
DB_HOST=mysql
DB_PORT=3306
DB_USER=evaluation
DB_NAME=ai_evaluation
DB_PASSWORD=change_me_db_password

# ---- 密钥（启动强校验：jwt_secret ≥256bit；fernet_keys 非空）----
# fernet_keys 逗号分隔多代（格式 urlsafe_base64n 32字节），首代用于加密，其余用于解密旧数据
FERNET_KEYS=
# JWT 签名密钥，必须 ≥32 字节（256bit）
JWT_SECRET=

# ---- LLM profile（judge 用，OpenAI 兼容端点；评测环境按需填写）----
JUDGE_API_KEY=
REVIEW_API_KEY=

# ---- 宿主机 4 个 agent 通过 host.docker.internal 访问（Windows/Mac 默认支持，Linux 需加 extra_hosts）----
# 见 docker-compose.yml extra_hosts 与 core/http.py 的 base_url_allowlist
