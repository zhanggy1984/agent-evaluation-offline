# ============ AI Agent 评测系统 环境变量模板 ============
# 复制为 .env 后填写；脚本 scripts/init-env.ps1 会自动生成随机密钥并写入。
# env 只放密钥类；业务参数（权重/阈值/并发/超时/单价）一律落 system_config 表。

# ---- 运行环境 ----
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- MySQL（docker-compose 内网地址）----
DB_HOST=mysql
DB_PORT=3306
DB_USER=evaluation
DB_NAME=ai_evaluation
DB_PASSWORD=change_me_db_password
# P2-C3 迁移专用账号（alembic DDL，仅启动迁移用）；不配则回退 DB_USER 单账号
# DB_MIGRATE_USER=evaluation_migrate
# DB_MIGRATE_PASSWORD=change_me

# ---- 密钥（启动强校验：jwt_secret ≥256bit；fernet_keys 非空）----
# fernet_keys 逗号分隔多代（格式 urlsafe_base64n 32字节），首代用于加密，其余用于解密旧数据
FERNET_KEYS=
# JWT 签名密钥，必须 ≥32 字节（256bit）
JWT_SECRET=

# ---- LLM profile（judge 用，OpenAI 兼容端点；评测环境按需填写）----
JUDGE_API_KEY=

# ---- 走查/演示账号（仅本地评测环境；P0：生产不设即不建，避免已知口令账号）----
# DEMO_EVALUATOR_PASSWORD=change_me
# DEMO_VIEWER_PASSWORD=change_me

# ---- 账号初始密码（P2-D18：验证脚本不再写死凭据，统一从 env 读）----
# 空库重建 admin 初始密码（seed 优先取此值；首登强制改密）
# ADMIN_PASSWORD=change_me
# verify_fresh_start 改密后统一密码（容器内跑验证脚本用；缺省 Verify#Reset2026）
# SMOKE_PASSWORD=change_me

# ---- 被评 agent 调用凭证（P2-D17：seed 不再含明文，缺省则匿名调用）----
# JSON 格式，key=agent name：
# AGENT_AUTH_SECRETS={"customer-service":{"username":"admin","password":"change_me"}}

# ---- 宿主机 4 个 agent 通过 host.docker.internal 访问（Windows/Mac 默认支持，Linux 需加 extra_hosts）----
# 见 docker-compose.yml extra_hosts 与 core/http.py 的 base_url_allowlist
